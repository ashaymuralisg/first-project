# Copy to .env and fill in. Never commit .env.
NODE_ENV=production
PORT=3000
HOST=0.0.0.0

# Staff auth — generate with: npm run hash -- 'your-strong-password'
STAFF_PASSWORD_HASH=
# Secret used to sign session cookies (use a long random string)
SESSION_SECRET=

# Where booking data lives
DB_PATH=./data/overbrod.db
RETENTION_DAYS=60

# Email (SMTP). If unset, emails are logged, not sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=OVERBRØD <overbrodsg@gmail.com>
DELI_EMAIL=overbrodsg@gmail.com

# Path to the static site to serve (defaults to ../site)
# SITE_DIR=../site
